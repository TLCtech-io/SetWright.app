# Copy to apps/web/.env.local (gitignored) and fill in. Never commit real values.

# Which data source the app reads:
#   mock     - the in-memory store; no database needed (the default for local dev/tests)
#   supabase - the real database, read through the signed-in user's RLS-scoped client
DATA_SOURCE=mock

# DEV ONLY, mock mode only: who "the signed-in member" is. Unset = the director (the
# default director-console loop). Set to an active member id (e.g. m2 = Ben, a plain
# member) to browse the member views as that person; any other value picks the first
# non-director member. Ignored under DATA_SOURCE=supabase, where auth resolves identity.
# MOCK_MEMBER_ID=m2

# Supabase project config. REQUIRED when DATA_SOURCE=supabase.
# These two are PUBLIC: Next inlines them into the browser bundle, which is fine — the
# anon key is meant to be public and is constrained by Row-Level Security.
# For a local stack, `npx supabase start` prints both (URL is http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret, for privileged/admin operations (e.g. the member-invite edge flow).
# It BYPASSES RLS, so it must never reach the browser: do NOT prefix it with NEXT_PUBLIC_
# (Next only ships NEXT_PUBLIC_* to the client) and only read it via lib/env.server.ts.
SUPABASE_SERVICE_ROLE_KEY=
